{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "$CHECKPOINT:unet_name"}, "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
