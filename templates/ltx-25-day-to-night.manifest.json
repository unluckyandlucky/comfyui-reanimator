{
  "id": "ltx-25-day-to-night",
  "name": "LTX-2.5 · Day to Night (relight)",
  "model": "ltx-25-day-to-night",
  "kind": "video",
  "version": 1,
  "intents": {
    "video_day_to_night": {
      "requires": [
        "sourceVideo"
      ],
      "note": "Video in, the same shot at night, frame for frame. The user's words set the night look (moonlight, tungsten, LED...)."
    }
  },
  "priority": 10,
  "description": "Re-renders a daytime shot as night with Lightricks' Day-to-Night IC-LoRA on LTX-2.5 distilled, one stage at the source's own size. Trained on 768x448 exteriors at 97 frames. Made for the cloud GPU.",
  "inputStrategy": "roles",
  "images": 0,
  "roles": {
    "sourceVideo": {
      "slot": "$VIDEO_1",
      "required": true,
      "max": 1,
      "note": "The daytime clip, 24 fps. Best around 97 frames; longer clips drift toward the end."
    }
  },
  "slots": {
    "$VIDEO_1": {
      "required": true,
      "note": "source video"
    },
    "$PROMPT": {
      "required": true
    },
    "$NEGATIVE": {
      "required": false,
      "note": "The card's negative. Has no effect at cfg 1 (the distilled schedule)."
    },
    "$SEED": {
      "required": false,
      "randomizePerRun": false
    },
    "$CHECKPOINT": {
      "required": true,
      "note": "chosen from requires.checkpoints, never by the caller"
    },
    "$OUTPUT": {
      "required": true
    }
  },
  "requires": {
    "backends": [
      "cuda"
    ],
    "nodes": [
      "CFGGuider",
      "CLIPLoader",
      "CLIPTextEncode",
      "CreateVideo",
      "EmptyLTXVLatentVideo",
      "GetImageSize",
      "GetVideoComponents",
      "ImageBatch",
      "ImageCrop",
      "ImageFromBatch",
      "ImagePadForOutpaint",
      "KSamplerSelect",
      "LTXAddVideoICLoRAGuide",
      "LTXICLoRALoaderModelOnly",
      "LTXVConcatAVLatent",
      "LTXVConditioning",
      "LTXVCropGuides",
      "LTXVEmptyLatentAudio",
      "LTXVSeparateAVLatent",
      "LoadVideo",
      "ManualSigmas",
      "RandomNoise",
      "RepeatImageBatch",
      "SamplerCustomAdvanced",
      "SaveVideo",
      "UNETLoader",
      "VAEDecodeTiled",
      "VAELoader",
      "easy mathInt"
    ],
    "checkpoints": {
      "slot": "$CHECKPOINT",
      "variants": {
        "int8_convrot": {
          "folder": "diffusion_models",
          "file": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
          "gb": 21.5,
          "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
          "requiresNativeOps": [
            "int8_tensorwise",
            "convrot_w4a4"
          ]
        }
      },
      "preferred": "int8_convrot",
      "alternatives": []
    },
    "models": [
      {
        "folder": "text_encoders",
        "file": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
        "gb": 15.37,
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
        "note": "Encodes the empty prompt only, once per run."
      },
      {
        "folder": "vae",
        "file": "ltx-2.5-video-vae-bf16.safetensors",
        "gb": 1.47,
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/vae/ltx-2.5-video-vae-bf16.safetensors"
      },
      {
        "folder": "vae",
        "file": "ltx-2.5-audio-vae-bf16.safetensors",
        "gb": 0.36,
        "url": "https://huggingface.co/Lightricks/LTX-2.5/resolve/main/vae/ltx-2.5-audio-vae-bf16.safetensors",
        "note": "Only to size the silent audio latent LTX-2.x samples alongside the video."
      },
      {
        "folder": "loras",
        "file": "ltx-2.5-22b-ic-lora-day-to-night-0.9.safetensors",
        "gb": 0.33,
        "url": "https://huggingface.co/Lightricks/LTX-2.5-22b-IC-LoRA-Day-To-Night/resolve/main/ltx-2.5-22b-ic-lora-day-to-night-0.9.safetensors"
      }
    ],
    "compatibility": {
      "tier": "full",
      "minimumVramGb": 48,
      "note": "Full-HD 145-frame clips need an H100/B200-class GPU (model card). Meant for RunPod (RTX PRO 6000 / H100)."
    },
    "nodePacks": [
      {
        "name": "ComfyUI-LTXVideo",
        "provides": [
          "LTXAddVideoICLoRAGuide",
          "LTXICLoRALoaderModelOnly"
        ],
        "note": "Lightricks' own pack; the IC-LoRA nodes are not in ComfyUI core."
      },
      {
        "name": "comfyui-easy-use",
        "provides": [
          "easy mathInt"
        ]
      }
    ]
  },
  "notes": [
    "Built by tools/build_ltx25_iclora_templates.py; edit that script, not this file.",
    "Weights are gated on Hugging Face: each IC-LoRA repo has its own license gate to accept."
  ],
  "tier": "full",
  "minimumVramGb": 48,
  "prompt": {
    "slot": "$PROMPT",
    "instructionParameter": "instruction",
    "lines": [
      {
        "text": "A realistic nighttime scene. Only the lighting changes from day to night; identical composition, framing, camera movement and motion."
      }
    ],
    "note": "The night frame always goes first; the user's description of the light follows. The reference drives structure, so the words mainly set brightness and colour temperature."
  }
}
